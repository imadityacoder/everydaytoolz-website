# Supabase Configuration (Optional for client-side tool functionality, required for tool_stats & shared_calculations)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for SEO Canonical & OpenGraph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AdSense (Optional in development, loads zero-CLS wireframe slots)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
